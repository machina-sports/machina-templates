    },
    {
      "path": "tests/test_iptc_capability_matrix.py",
      "group": "canonical"
    },
    {
      "path": "tests/test_iptc_cli_rights_gate.py",
      "group": "canonical",
      "timeout_seconds": 600
    },
    {
      "path": "tests/test_iptc_cross_provider_equivalence.py",
      "group": "canonical"
    },
    {
      "path": "tests/test_iptc_identity_resolution_method.py",
      "group": "canonical"
    },
    {
      "path": "tests/test_iptc_multi_participant_contract.py",
      "group": "canonical"
    },
    {
      "path": "tests/test_iptc_source_ref_credentials.py",
      "group": "canonical"
    },
    {
      "path": "tests/test_iptc_sports_skills_reference_contract.py",
      "group": "canonical"
    },
    {
      "path": "tests/test_iptc_api_football_adapter.py",
      "group": "adapters"
