  "paths": {
    "/world-cup/v1/backtest-forecasts": {
      "post": {
        "summary": "Historical forecast backtests",
        "description": "Scores the 98 original archived forecasts computed before kickoff against verified 90-minute results, including AET/PEN fixtures through regulation_time_score. Six late forecasts are excluded. CLV and market calibration remain explicitly unsupported. This completed World Cup path is read-only.",
        "x-zeroclick-services": ["forecasts"],
        "x-payment-info": {"protocols": [{"mpp": {"method": "tempo", "intent": "charge", "currency": "USD"}}, {"x402": {"network": "eip155:8453", "scheme": "exact", "currency": "USDC"}}], "offers": [{"amount": "120000", "currency": "0x20C000000000000000000000b9537d11c60E8b50", "description": "$0.120000 per call (backtest, service forecasts)", "intent": "charge", "method": "tempo"}], "price": {"mode": "fixed", "currency": "USD", "amount": "0.120000"}, "rates": [{"service": "forecasts", "meter": "backtest", "unit": "call", "unitSize": 1, "priceUsd": "0.120000", "includedUnits": 0}]},
        "requestBody": {"required": false, "content": {"application/json": {"schema": {"type": "object", "properties": {"competition": {"type": "string", "enum": ["world-cup-2026"], "default": "world-cup-2026"}, "league": {"type": "string", "enum": ["", "1"], "default": ""}, "season": {"type": "string", "enum": ["", "2026"], "default": ""}, "calibration_window_days": {"type": "integer", "const": 90, "default": 90}}}, "examples": {"completedTournament": {"value": {"competition": "world-cup-2026"}}}}}},
        "responses": {"200": {"description": "Archive backtest with total, included, excluded, sources, reasons, and track record.", "content": {"application/json": {"schema": {"anyOf": [{"$ref": "#/components/schemas/BacktestResponse"}, {"$ref": "#/components/schemas/UnavailableResponse"}]}}}}, "400": {"description": "Invalid competition or request value."}, "402": {"description": "Payment required."}}
      }
    },
    "/world-cup/v1/get-event-context": {
      "post": {
        "summary": "Enriched context for one match",
