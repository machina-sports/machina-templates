{
  "openapi": "3.1.0",
  "info": {
    "title": "Machina Sports World Cup Intelligence",
    "version": "1.3.0",
    "description": "The canonical eleven-route World Cup 2026 storefront contract. The active runtime remains v2; the tested v3 contract is an inactive local publication candidate with the final published FIFA registration snapshot and raw-player reconciliation. Valid archive hits skip legacy work and archive errors fail closed."
  },
  "servers": [
    {
      "url": "https://agents.machina.gg/zcj/ajgpivnid8bn",
      "description": "Pay-per-use access to Machina Sports's API"
    }
  ],
  "security": [{"payPerUse": []}],
  "x-transport-contract": "The 200 schemas describe the workflow's public source response. The external HTTP gateway may wrap it in a transport envelope; that envelope is platform-owned and is not implemented or asserted by this repository.",
  "components": {
