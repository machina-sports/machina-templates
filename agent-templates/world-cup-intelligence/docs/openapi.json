      "TeamSummary": {
        "type": "object", "required": ["name"],
        "properties": {"team_urn": {"type": ["string", "null"]}, "name": {"type": "string"}, "qualifier": {"type": "string"}, "crest": {"type": ["string", "null"]}}
      },
      "Score": {
        "type": ["object", "null"],
        "properties": {"home": {"type": "integer", "minimum": 0}, "away": {"type": "integer", "minimum": 0}, "elapsed": {"type": "number", "minimum": 0}}
      },
      "ResultDetails": {
