          "identity_mapping_status": {"const": "official_reconciled"}, "team_name": {"type": "string"},
          "fifa_team_code": {"type": "string"}, "jersey_number": {"type": "integer", "minimum": 1, "maximum": 26},
          "player_name_raw": {"type": "string"}, "first_names_raw": {"type": "string"},
          "last_names_raw": {"type": "string"}, "shirt_name_raw": {"type": "string"},
          "birth_date": {"type": "string", "format": "date"}, "position_code": {"enum": ["GK", "DF", "MF", "FW"]},
          "club_raw": {"type": ["string", "null"]}, "height_cm": {"type": "integer"},
          "international_caps_as_reported": {"type": "integer"}, "international_goals_as_reported": {"type": "integer"},
          "source_page": {"type": "integer", "minimum": 1, "maximum": 48},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "canonical_birth_date": {"type": ["string", "null"]}, "canonical_birth_date_conflict": {"type": "boolean"}
        }
      },
      "OfficialRegistrationSnapshot": {
