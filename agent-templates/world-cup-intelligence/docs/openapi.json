          "source_provenance": {"type": "array", "items": {"type": "string"}},
          "population_count": {"type": ["integer", "null"], "minimum": 0, "description": "Null means the legacy response did not record this count; null is never equivalent to zero."},
          "eligible_count": {"type": ["integer", "null"], "minimum": 0},
          "included_count": {"type": ["integer", "null"], "minimum": 0},
          "excluded_count": {"type": ["integer", "null"], "minimum": 0},
          "exclusion_reasons": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "unsupported_fields": {"type": "array", "items": {"type": "string"}}
