          "fixture_id": {"type": ["string", "integer"]}, "result_details": {"$ref": "#/components/schemas/ResultDetails"}
        }
      },
      "ResolveResponse": {
        "allOf": [{"$ref": "#/components/schemas/ResponseBase"}, {"type": "object", "required": ["entity", "entities", "count"], "properties": {"entity": {"$ref": "#/components/schemas/Entity"}, "entities": {"type": "array", "items": {"$ref": "#/components/schemas/Entity"}}, "count": {"type": "integer", "minimum": 0}}}]
      },
      "ScheduleResponse": {
        "allOf": [{"$ref": "#/components/schemas/ResponseBase"}, {"type": "object", "required": ["schedule"], "properties": {"schedule": {"type": "object", "required": ["events", "count", "total_count", "offset", "limit", "has_more", "truncated"], "properties": {"events": {"type": "array", "items": {"$ref": "#/components/schemas/FixtureSummary"}}, "count": {"type": "integer"}, "total_count": {"type": "integer"}, "offset": {"type": "integer"}, "limit": {"type": "integer"}, "has_more": {"type": "boolean"}, "truncated": {"type": "boolean"}, "warnings": {"type": "array", "items": {"type": "string"}}}}}}]
      },
      "EventContextResponse": {
        "allOf": [{"$ref": "#/components/schemas/ResponseBase"}, {"type": "object", "required": ["event_context", "event_urn", "resolved_fixture", "candidates"], "properties": {"event_context": {"type": "object", "required": ["event", "result_details", "sports_context", "context_coverage"], "properties": {"event": {"$ref": "#/components/schemas/Entity"}, "prematch_research": {"type": "object"}, "social_pulse": {"type": "object"}, "sports_context": {"type": "object", "required": ["status", "mode", "result_details", "final_group_standings"]}, "result_details": {"$ref": "#/components/schemas/ResultDetails"}, "context_coverage": {"type": "object", "required": ["sports_context", "prematch_research", "social_pulse", "reason"]}}}, "event_urn": {"type": "string"}, "resolved_fixture": {"$ref": "#/components/schemas/FixtureSummary"}, "candidates": {"type": "array", "items": {"$ref": "#/components/schemas/FixtureSummary"}}}}]
      },
      "StandingsResponse": {
        "allOf": [{"$ref": "#/components/schemas/ResponseBase"}, {"type": "object", "required": ["standings"], "properties": {"standings": {"type": "object", "required": ["groups", "group_count", "third_place_ranking", "standings_scope", "team_count", "is_final_1_to_48_ranking"], "properties": {"groups": {"type": "array", "minItems": 12, "maxItems": 12}, "group_count": {"const": 12}, "third_place_ranking": {"type": "array", "minItems": 12, "maxItems": 12}, "standings_scope": {"const": "final_group_standings"}, "team_count": {"const": 48}, "is_final_1_to_48_ranking": {"const": false}}}}}]
      },
      "SquadsResponse": {
        "allOf": [{"$ref": "#/components/schemas/ResponseBase"}, {"type": "object", "required": ["squads", "candidates"], "properties": {"squads": {"type": "object", "required": ["teams", "evidence_status", "official_registration_status", "observed_player_count", "official_registration_snapshot"], "properties": {"teams": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["side"]}}, "evidence_status": {"enum": ["observed_tournament_player_pool", "unavailable"]}, "official_registration_status": {"const": "verified_final_published_snapshot"}, "observed_player_count": {"type": "integer", "minimum": 0}, "official_registration_snapshot": {"$ref": "#/components/schemas/OfficialRegistrationSnapshot"}}}, "candidates": {"type": "array", "items": {"$ref": "#/components/schemas/FixtureSummary"}}}}]
      },
      "InjuriesResponse": {
        "allOf": [{"$ref": "#/components/schemas/ResponseBase"}, {"type": "object", "required": ["injuries", "candidates"], "properties": {"injuries": {"type": "object", "required": ["source", "teams", "evidence_status", "observed_record_count", "historical_completeness_verified"], "properties": {"source": {"type": "string"}, "teams": {"type": "array", "items": {"type": "object", "required": ["side", "count", "missing"]}}, "evidence_status": {"enum": ["recorded_absences", "confirmed_none", "unavailable"]}, "observed_record_count": {"type": "integer", "minimum": 0}, "historical_completeness_verified": {"type": "boolean"}}}, "candidates": {"type": "array", "items": {"$ref": "#/components/schemas/FixtureSummary"}}}}]
      },
      "PlayerPerformanceResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/ResponseBase"},
          {
            "type": "object",
            "required": ["fixture_player_pack", "status", "identity_coverage"],
            "properties": {
              "fixture_player_pack": {"type": "object", "required": ["event_urn", "fixture_id", "player_count"], "properties": {"players": {"type": "array"}, "raw_player_count": {"type": "integer", "minimum": 0}}},
              "status": {"type": "string"},
              "identity_coverage": {"type": "object", "required": ["canonical_count", "provider_only_count", "ambiguous_omitted_count"]},
