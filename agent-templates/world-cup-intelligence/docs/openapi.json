          "opponent": {"type": "string", "description": "Opponent name used to disambiguate."},
          "date": {"type": "string", "format": "date", "description": "Fixture date, YYYY-MM-DD."}
        },
        "description": "Supply an exact id or enough team/date information to resolve exactly one fixture. Multiple supplied selectors are conjunctive. Ambiguous requests return candidates and do not call a provider."
