          "competition": {"const": "FIFA World Cup 2026"},
          "competition_status": {"const": "completed"},
          "live": {"const": false},
          "snapshot_as_of": {"type": ["string", "null"]},
          "source_observed_at": {"type": ["string", "null"]},
          "content_created_at": {"type": ["string", "null"]},
