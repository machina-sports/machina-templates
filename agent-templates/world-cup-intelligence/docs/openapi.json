          "published_at": {"type": "string", "format": "date-time"}, "source_url": {"type": "string", "format": "uri"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "snapshot_team_count": {"const": 48},
          "players_per_team": {"const": 26}, "teams": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/components/schemas/OfficialRegistrationTeam"}},
          "completeness": {"type": "object"}, "limitations": {"type": "array", "items": {"type": "string"}}
        }
