          "provenance": {"type": "object", "required": ["provider", "fixture_id", "provider_result_sha256", "source_url", "observed_at"], "properties": {"provider": {"type": "string"}, "fixture_id": {"type": "string"}, "provider_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_url": {"type": "string", "format": "uri"}, "observed_at": {"type": ["string", "null"]}}}
        }
      },
      "FixtureSummary": {
        "type": "object", "required": ["event_urn", "name", "start_date", "status", "teams", "fixture_id"],
        "properties": {
          "event_urn": {"type": "string"}, "name": {"type": "string"}, "start_date": {"type": "string"}, "status": {"type": "string"},
          "competition": {"type": "string"}, "score": {"$ref": "#/components/schemas/Score"}, "round": {"type": ["string", "null"]}, "stage": {"type": ["string", "null"]},
